# Esta versión solo admite simulación. false detiene el programa.
DRY_RUN=true
# Mínimo permitido: 30 segundos.
CHECK_INTERVAL_SECONDS=45
MAX_PRODUCT_PRICE=50.00
MAX_TOTAL_PRICE=60.00
MAX_SHIPPING_PRICE=10.00
# Obligatoriamente una sola unidad.
MAX_QUANTITY=1
# demo valida un ejemplo local. ninnin monitoriza el producto fijo de Nin-Nin.
SHOP_MODULES=demo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true permite probar sin Telegram; para monitorizar realmente usa false.
ALLOW_NO_TELEGRAM=true
DATA_DIR=data
SCREENSHOT_DIR=screenshots

# Moneda de los límites para Nin-Nin. No se convierte entre monedas.
NINNIN_CURRENCY=EUR

# Correo SMTP opcional. STARTTLS obligatorio; no guardar contraseñas en Git.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
